{
  "manifest_version": 3,
  "name": "Elementor Browser Bridge",
  "version": "1.0.0",
  "description": "User-approved browser controls for Elementor AI.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://allinoneedition.vercel.app/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Elementor Browser Bridge" },
  "content_scripts": [{
    "matches": ["https://allinoneedition.vercel.app/elementor*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}